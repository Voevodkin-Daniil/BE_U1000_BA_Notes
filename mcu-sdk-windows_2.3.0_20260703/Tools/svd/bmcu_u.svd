                                    <value>0</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>ACTIVE</name>
                                    <description>Set the Channel 2 output to the active level when the comparison circuit \
 is triggered; When CNT=CCR2, OC2REF=1 is set.</description>
                                    <value>1</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>INACTIVE</name>
                                    <description>Set the Channel 2 output to the inactive level when the comparison circuit \
 is triggered; When CNT=CCR2, OC2REF=0 is set.</description>
                                    <value>2</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>TOGGLE</name>
                                    <description>Toggle; When CNT=CCR2, OC2REF = not OC2REF is set.</description>
                                    <value>3</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>FORCED_INACTIVE</name>
                                    <description>Force switch to the inactive state; OC2REF=0.</description>
                                    <value>4</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>FORCED_ACTIVE</name>
                                    <description>Force switch to the active state; OC2REF=1.</description>
                                    <value>5</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>PWM1</name>
                                    <description>PWM mode 1; When counting up, Channel 2 is active (OC2REF=1) \

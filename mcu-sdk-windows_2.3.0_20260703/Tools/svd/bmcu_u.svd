                                    <value>0</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>ACTIVE</name>
                                    <description>Set the Channel 0 output to the active level when the comparison circuit is triggered; When CNT=CCR0, OC0REF=1 is set.</description>
                                    <value>1</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>INACTIVE</name>
                                    <description>Set the Channel 0 output to the inactive level when the comparison circuit is triggered; When CNT=CCR0, OC0REF=0 is set.</description>
                                    <value>2</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>TOGGLE</name>
                                    <description>Toggle; When CNT=CCR0, OC0REF = not OC0REF is set.</description>
                                    <value>3</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>FORCED_INACTIVE</name>
                                    <description>Force switch to the inactive state; OC0REF=0.</description>
                                    <value>4</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>FORCED_ACTIVE</name>
                                    <description>Force switch to the active state; OC0REF=1.</description>
                                    <value>5</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>PWM1</name>
                                    <description>PWM mode 1; When counting up, Channel 0 is active (OC0REF=1) \
 until (CNT less-than-or-equal CCR0), otherwise Channel 0 is inactive (OC0REF=0); \

 When counting down, Channel 0 is inactive (OC0REF=0) \

 until (CNT greater-than-or-equal CCR0), otherwise Channel 0 is active (OC0REF=1).</description>
                                    <value>6</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>PWM2</name>
                                    <description>PWM Mode 2; When counting up, Channel 0 is inactive (OC0REF=0) \

%rename link				nano_link
%rename link_gcc_c_sequence	nano_link_gcc_c_sequence
%rename cpp					nano_cpp
%rename cc1plus				nano_cc1plus

*archi:
%{mabi=*:rv32imc_zicsr_zifencei_zba_zbb_zbc_zbs/%*}

*nano_lib_path:
%:getenv(GCC_EXEC_PREFIX ../../newlib-nano/riscv32-none-elf/lib/%(archi))

*nano_gcc_lib_path:
%:getenv(GCC_EXEC_PREFIX ../../newlib-nano/lib/gcc/riscv32-none-elf/15.2.0/%(archi))

*cpp:
-isystem %:getenv(GCC_EXEC_PREFIX ../../newlib-nano/riscv32-none-elf/include) %(nano_cpp)

*cc1plus:
-idirafter %:getenv(GCC_EXEC_PREFIX ../../newlib-nano/riscv32-none-elf/include) %(nano_cc1plus)

*nano_libc:
-lc_nano

*link_gcc_c_sequence:
%(nano_link_gcc_c_sequence) --start-group %G %(nano_libc) --end-group

*link:
%(nano_link) %:replace-outfile(-lc -lc_nano) %:replace-outfile(-lg -lg_nano) %:replace-outfile(-lm -lm_nano) %:replace-outfile(-lstdc++ -lstdc++_nano) %:replace-outfile(-lsupc++ -lsupc++_nano) -L%(nano_lib_path) -L%(nano_gcc_lib_path)
